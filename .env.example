# 텔레그램 봇 토큰 (@BotFather에게서 발급받은 문자열)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 내 텔레그램 채팅 ID (@userinfobot 등에서 확인한 숫자)
TELEGRAM_CHAT_ID=123456789

# 스캔 주기 (분 단위, 기본 15분)
SCAN_INTERVAL_MIN=15

# 알림을 발송할 최소 종합 점수 (기본 3.0점 이상)
MIN_SCORE_NOTIFY=3.0

# 동일 종목 중복 알림 방지 쿨다운 시간 (시간 단위, 기본 4시간)
COOLDOWN_HOURS=4.0

# Render 웹 포트 (기본 10000)
PORT=10000
