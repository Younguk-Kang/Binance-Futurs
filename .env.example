# 텔레그램 봇 토큰 (@BotFather에게서 발급받은 문자열)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 내 텔레그램 채팅 ID (@userinfobot 등에서 확인한 숫자)
TELEGRAM_CHAT_ID=123456789

# 스캔 주기 (분 단위, 기본 15분)
SCAN_INTERVAL_MIN=15

# 알림을 발송할 최소 종합 점수 (기본 3.0점 이상)
MIN_SCORE_NOTIFY=3.0

# 동일 종목 중복 알림 방지 쿨다운 시간 (시간 단위, 24시간 거래량 초기화 후 재판단)
COOLDOWN_HOURS=24.0

# 24시간 최소 누적 거래대금 하한선 (단위: 백만 달러, 기본 30 = $30M)
LIVE_MIN_VOL_MILLION=30.0

# 직전 7일 대비 거래량 폭증 배수 하한 (기본 2.0배 이상)
LIVE_MIN_VOLX=2.0

# 최근 72h 상승률 하한 (기본 0.10 = 10% 이상)
LIVE_MIN_RET72=0.10

# Render 웹 포트 (기본 10000)
PORT=10000
